<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de DetalleIncidenciaActivity.
    ScrollView raíz para que el contenido sea accesible en pantallas pequeñas.
    El padding del ScrollView actúa sobre su contenido y deja espacio en los bordes.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!--
        Tarjeta Material que agrupa toda la información de la incidencia.
        cardCornerRadius=12dp y cardElevation=4dp dan un aspecto elevado y moderno.
        strokeColor y strokeWidth añaden un borde gris sutil.
    -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#DADADA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Estado actual: emoji de color + texto (🔴 Abierta / 🟡 En proceso / 🟢 Cerrada) -->
            <TextView
                android:id="@+id/tvDetalleEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔴 Abierta"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Aeronave a la que pertenece la incidencia -->
            <TextView
                android:id="@+id/tvDetalleAeronave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aeronave: -"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Zona de la aeronave donde se encontró el FOD -->
            <TextView
                android:id="@+id/tvDetalleZona"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zona: -"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Categoría del objeto FOD (traducida al español desde el ENUM interno) -->
            <TextView
                android:id="@+id/tvDetalleTipoFod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Tipo FOD: -"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Nivel de urgencia de la incidencia con indicador emoji de color -->
            <TextView
                android:id="@+id/tvDetallePrioridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Prioridad: -"
                android:textSize="14sp"
                android:layout_marginBottom="12dp" />

            <!-- Fecha y hora en que se detectó/registró la incidencia -->
            <TextView
                android:id="@+id/tvFechaDeteccion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de detección: -"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Fecha y hora de cierre; muestra "No cerrada" si aún está abierta -->
            <TextView
                android:id="@+id/tvFechaCierre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fecha de cierre: -"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Días que lleva o estuvo abierta la incidencia (resaltado en negrita) -->
            <TextView
                android:id="@+id/tvDiasAbierta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Días abierta: -"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp" />

            <!-- Nombre y apellidos del usuario que registró la incidencia -->
            <TextView
                android:id="@+id/tvDetalleDeclarante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Declarante: -"
                android:textSize="14sp"
                android:layout_marginBottom="6dp" />

            <!-- Número de empleado del declarante -->
            <TextView
                android:id="@+id/tvDetalleNumeroEmpleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nº empleado: -"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!-- Cabecera de la sección de descripción -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descripción"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <!-- Texto libre de descripción del hallazgo FOD -->
            <TextView
                android:id="@+id/tvDetalleDescripcion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sin descripción"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />

            <!--
                Imagen fotográfica del hallazgo FOD.
                Oculta por defecto (visibility="gone"); DetalleIncidenciaActivity la muestra
                si la incidencia tiene imagenUrl usando Glide.
                scaleType="centerCrop" escala y recorta la imagen para llenar el espacio.
            -->
            <ImageView
                android:id="@+id/imgDetalleIncidencia"
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:scaleType="centerCrop"
                android:adjustViewBounds="true"
                android:visibility="gone"
                android:layout_marginBottom="16dp" />

            <!--
                Contenedor de botones de cambio de estado.
                Oculto por defecto; visible solo para roles con permiso y si la incidencia
                no está ya cerrada. Los botones individuales se muestran/ocultan
                según el estado actual (ver DetalleIncidenciaActivity.configurarBotonesSegunRolYEstado).
            -->
            <LinearLayout
                android:id="@+id/layoutBotonesEstado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Avanza la incidencia de "abierta" a "en_proceso". Visible en estado "abierta" -->
                <Button
                    android:id="@+id/btnPasarEnProceso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Pasar a en proceso"
                    android:layout_marginBottom="8dp" />

                <!-- Cierra definitivamente la incidencia. Visible en estados "abierta" y "en_proceso" -->
                <Button
                    android:id="@+id/btnCerrarIncidencia"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cerrar incidencia" />
            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</ScrollView>