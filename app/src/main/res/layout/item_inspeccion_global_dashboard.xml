<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardInspeccionGlobal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAeronaveGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A400M - MSN001"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFechaGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Fecha: 16/06/2026"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- Turno de la inspección global.
     Ahora una inspección global se agrupa por día, aeronave y turno. -->
        <TextView
            android:id="@+id/tvTurnoGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕒 Turno: Mañana"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvEstadoCompletitudGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✅ Completa (14/14 zonas)"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvEstadoFodGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🟢 Sin FOD declarado"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTituloZonasInspeccionadasGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zonas inspeccionadas:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/llZonasInspeccionadasGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTituloZonasFodGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zonas con FOD:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/llZonasFodGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tvTituloPendientesGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pendientes:"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/llPendientesGlobal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>