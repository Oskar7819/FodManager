<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de UsuariosFragment.
    LinearLayout vertical idéntico en estructura al de inspecciones:
    RecyclerView con peso + FAB para crear nuevos usuarios.
    El fragment completo solo es visible para administrador, mando_gp4 y focal_point_fod;
    HomeActivity controla la visibilidad de su pestaña en el Bottom Navigation.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!--
        Lista de tarjetas de usuarios filtrada según el rol del usuario logueado.
        paddingBottom=88dp evita que el último item quede tapado por el FAB.
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerUsuarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="88dp" />

    <!-- FAB para abrir NuevoUsuarioActivity y crear un nuevo usuario -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNuevoUsuario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_margin="16dp"
        android:src="@android:drawable/ic_input_add"
        android:contentDescription="Nuevo usuario" />

</LinearLayout>