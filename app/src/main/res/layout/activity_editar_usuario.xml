<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de EditarUsuarioActivity.
    ScrollView para que el formulario sea accesible con el teclado virtual desplegado.
    Solo permite editar la aeronave asignada; el rol es solo lectura.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- Título del formulario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Editar Usuario"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Nombre completo del usuario (solo lectura, no editable) -->
        <TextView
            android:id="@+id/tvEditarNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Email del usuario en gris secundario (solo lectura) -->
        <TextView
            android:id="@+id/tvEditarEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="24dp" />

        <!-- Etiqueta del campo rol -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rol"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Rol actual del usuario (solo lectura; no se puede cambiar desde la app) -->
        <TextView
            android:id="@+id/tvEditarRol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!--
            Etiqueta del Spinner de aeronave.
            EditarUsuarioActivity la oculta (isVisible = false) para roles que
            no se adscriben a aeronaves (administrador, focal_point_fod, head_plant).
        -->
        <TextView
            android:id="@+id/tvEditarAeronaveLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aeronave asignada"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!--
            Spinner con las aeronaves activas disponibles para asignar al usuario.
            La primera opción es siempre "Sin aeronave asignada" (id=-1).
            Se oculta para roles que no se adscriben a aeronaves.
        -->
        <Spinner
            android:id="@+id/spinnerEditarAeronave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp" />

        <!-- Botón de guardado. Se deshabilita durante la petición de red -->
        <Button
            android:id="@+id/btnGuardarEdicion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar cambios"
            android:padding="12dp" />

        <!-- Indicador de carga visible solo durante el UPDATE en Supabase -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>