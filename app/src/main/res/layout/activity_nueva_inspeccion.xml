<?xml version="1.0" encoding="utf-8"?>
<!-- Declaración XML con codificación UTF-8 -->

<!-- ScrollView principal: permite desplazamiento vertical
 cuando el contenido no cabe en pantalla. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!--Contenedor principal en vertical para organizar todos los elementos
        del formulario uno debajo de otro. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Título de la pantalla -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Inspección"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Campo de texto para introducir la zona -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Zona"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <!-- EditText interno del campo Zona -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etZona"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de texto para escribir observaciones -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <!-- EditText multilínea para observaciones -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Etiqueta descriptiva para el selector de aeronave -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aeronave"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Spinner para seleccionar una aeronave -->
        <Spinner
            android:id="@+id/spinnerAeronave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Campo de texto para la ubicación de la aeronave -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ubicación de la aeronave"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_marginBottom="16dp">

            <!-- EditText interno para escribir la ubicación -->
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUbicacionAeronave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Casilla para indicar si se encontró FOD -->
        <CheckBox
            android:id="@+id/cbConFod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Se encontró FOD?"
            android:layout_marginBottom="24dp" />

        <!-- Botón para guardar la inspección -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar inspección"
            android:padding="12dp" />

        <!--
            Barra de progreso oculta por defecto.
            Se puede mostrar mientras se guarda la inspección.
        -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
