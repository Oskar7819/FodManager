<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de NuevaInspeccionActivity.
    ScrollView con formulario de nueva inspección. Los datos del inspector
    y de la aeronave se muestran como campos de solo lectura cargados automáticamente.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp">

        <!-- Título del formulario -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Inspección"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <!-- Cabecera de la sección del inspector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Inspector"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp" />

        <!-- Nombre del inspector (usuario logueado, solo lectura) -->
        <TextView
            android:id="@+id/tvInspectorNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nombre: -"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Apellidos del inspector (solo lectura) -->
        <TextView
            android:id="@+id/tvInspectorApellidos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Apellidos: -"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Número de empleado del inspector (solo lectura) -->
        <TextView
            android:id="@+id/tvInspectorNumeroEmpleado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nº empleado: -"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Etiqueta del Spinner de zona -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Zona"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!--
            Spinner con las 14 zonas obligatorias de inspección.
            NuevaInspeccionActivity lo rellena con la lista `zonas` y comprueba
            que la zona seleccionada no haya sido ya inspeccionada hoy antes de guardar.
        -->
        <Spinner
            android:id="@+id/spinnerZona"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!--
            Campo de texto multilinea para observaciones del inspector.
            Opcional: puede dejarse vacío.
        -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Observaciones"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine"
                android:minLines="3" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Etiqueta de la aeronave asignada -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aeronave asignada"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!--
            Aeronave asignada al inspector (solo lectura, cargada automáticamente).
            Usa @android:drawable/editbox_background para parecer un campo de texto.
            Si el usuario no tiene aeronave asignada, NuevaInspeccionActivity muestra
            "Sin adscripción" y deshabilita el botón Guardar.
        -->
        <TextView
            android:id="@+id/tvAeronaveAsignada"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aeronave: -"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp" />

        <!-- Etiqueta de la posición de la aeronave en el hangar -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Posición de la aeronave"
            android:textStyle="bold"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!--
            Ubicación física de la aeronave dentro del hangar (solo lectura).
            Se carga de la BD junto con los datos de la aeronave.
        -->
        <TextView
            android:id="@+id/tvPosicionAeronave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Posición: -"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@android:drawable/editbox_background"
            android:layout_marginBottom="16dp" />

        <!--
            CheckBox para indicar si se encontró FOD durante la inspección.
            Si se marca como true, desde DetalleInspeccionActivity se podrá
            registrar una incidencia vinculada a esta inspección.
        -->
        <CheckBox
            android:id="@+id/cbConFod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="¿Se encontró FOD?"
            android:layout_marginBottom="24dp" />

        <!-- Botón de guardado. Se deshabilita durante la petición de red -->
        <Button
            android:id="@+id/btnGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar inspección"
            android:padding="12dp" />

        <!-- Indicador de carga visible durante el INSERT en Supabase -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>