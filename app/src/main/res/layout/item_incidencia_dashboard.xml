<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardIncidenciaDashboard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="2dp"
    android:layout_marginEnd="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvAeronaveIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A400M - MSN001"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvFechaIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Detectada: 17/03/2026 09:15"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="4dp" />

        <!-- Turno en el que apareció la incidencia FOD. -->
        <TextView
            android:id="@+id/tvTurnoIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🕒 Turno: Mañana"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvEstadoIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔴 Abierta"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvDuracionIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⏳ Abierta desde hace 2 días"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:layout_marginBottom="6dp" />
        <TextView
            android:id="@+id/tvDeclaranteIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Juan Pérez · EMP001"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/tvZonaIncidencia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Zona: Tren principal"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>