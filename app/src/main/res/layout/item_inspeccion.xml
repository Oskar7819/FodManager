<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de una tarjeta de inspección en el RecyclerView de InspeccionesFragment.
    InspeccionesAdapter rellena sus TextViews en onBindViewHolder.
    El click sobre la tarjeta completa navega a DetalleInspeccionActivity.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Zona inspeccionada como título principal de la tarjeta (ej: "ENG#1") -->
        <TextView
            android:id="@+id/tvZona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Aeronave asociada a la inspección en gris secundario -->
        <TextView
            android:id="@+id/tvAeronave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- Fecha y hora de la inspección en gris secundario (ej: "22/03/2026  10:30") -->
        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- Línea compacta del inspector: "Nombre Apellidos · Nº empleado" -->
        <TextView
            android:id="@+id/tvInspectorResumen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <!-- Resultado de la inspección en negrita: "⚠️ Con FOD" o "✅ Sin FOD" -->
        <TextView
            android:id="@+id/tvConFod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>