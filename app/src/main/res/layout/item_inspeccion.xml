<?xml version="1.0" encoding="utf-8"?>
<!-- Declaración del documento XML con codificación UTF-8 -->

<!--
    MaterialCardView utilizada como tarjeta para mostrar
    la información de una inspección dentro de una lista.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <!--
        Contenedor interno que organiza los datos
        de la inspección en orientación vertical.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            TextView que muestra la zona donde se realizó la inspección.
            Es el dato principal por eso aparece en negrita.
        -->
        <TextView
            android:id="@+id/tvZona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que indica la aeronave asociada a la inspección.
        -->
        <TextView
            android:id="@+id/tvAeronave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que muestra la fecha en la que se realizó la inspección.
        -->
        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que indica si durante la inspección se detectó FOD
            (Foreign Object Debris).
        -->
        <TextView
            android:id="@+id/tvConFod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
