<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout raíz de HomeActivity.
    Divide la pantalla verticalmente en dos zonas:
    - fragmentContainer: ocupa todo el espacio disponible (weight=1) y aloja el fragment activo.
    - BottomNavigationView: fijo en la parte inferior con las cinco pestañas de navegación.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!--
        Contenedor donde HomeActivity carga y reemplaza los fragments del Bottom Navigation.
        height=0dp + layout_weight=1 hace que ocupe todo el espacio libre por encima del nav bar.
    -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!--
        Barra de navegación inferior con cinco pestañas.
        El menú @menu/bottom_nav_menu define las pestañas y sus iconos.
        La pestaña "Usuarios" (nav_usuarios) está oculta por defecto en el XML del menú
        y HomeActivity la hace visible dinámicamente según el rol del usuario.
    -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigationView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:menu="@menu/bottom_nav_menu" />

</LinearLayout>