<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de NuevaIncidenciaActivity.

    Se usa un ScrollView para asegurar la accesibilidad del formulario
    en pantallas pequeñas y cuando el teclado está visible.

    La pantalla se organiza en bloques visuales:
    - Datos del declarante
    - Información de la incidencia
    - Evidencia fotográfica

    Se mantienen los mismos IDs del proyecto para no afectar al código Kotlin.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <!--
        Tarjeta principal del formulario.
        Se usa MaterialCardView para dar una apariencia más moderna,
        coherente con la pantalla de detalle de incidencia.
    -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#DADADA">

        <!-- Contenedor vertical principal -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Título principal de la pantalla -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nueva Incidencia FOD"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="20dp" />

            <!-- ========================= -->
            <!-- BLOQUE: DECLARANTE -->
            <!-- ========================= -->

            <!-- Cabecera de la sección de datos del declarante -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Declarante"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Nombre del usuario logueado -->
            <TextView
                android:id="@+id/tvDeclaranteNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre: -"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!-- Apellidos del usuario logueado -->
            <TextView
                android:id="@+id/tvDeclaranteApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Apellidos: -"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!-- Número de empleado del usuario logueado -->
            <TextView
                android:id="@+id/tvDeclaranteNumeroEmpleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nº empleado: -"
                android:textSize="14sp"
                android:layout_marginBottom="20dp" />

            <!-- ========================= -->
            <!-- BLOQUE: INFORMACIÓN FOD -->
            <!-- ========================= -->

            <!-- Cabecera del bloque de información de la incidencia -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Información de la incidencia"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!--
                Campo de descripción del hallazgo FOD.
                Es obligatorio y se valida desde NuevaIncidenciaActivity.
                minLines=3 asegura una altura cómoda para escribir.
            -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Descripción del FOD"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:minLines="3"
                    android:gravity="top|start" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Etiqueta del selector de tipo de FOD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tipo de FOD"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!--
                Spinner con las categorías de FOD.
                Visualmente se muestran textos legibles, pero la Activity
                guarda el valor interno correspondiente.
            -->
            <Spinner
                android:id="@+id/spinnerTipoFod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp" />

            <!-- Etiqueta de la zona del avión -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zona del avión"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!--
                Zona heredada de la inspección origen.
                Es un dato de solo lectura y por eso se muestra como TextView
                con apariencia de campo visual.
            -->
            <TextView
                android:id="@+id/tvZonaAvion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Zona: -"
                android:textSize="14sp"
                android:padding="12dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="16dp" />

            <!-- Etiqueta del selector de prioridad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prioridad"
                android:textStyle="bold"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!--
                Spinner con el nivel de prioridad.
                La Activity muestra una versión legible y guarda
                el valor interno correspondiente.
            -->
            <Spinner
                android:id="@+id/spinnerPrioridad"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp" />

            <!-- ========================= -->
            <!-- BLOQUE: EVIDENCIA FOTOGRÁFICA -->
            <!-- ========================= -->

            <!-- Cabecera de la sección de fotografía -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Evidencia fotográfica"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Botón para abrir la cámara -->
            <Button
                android:id="@+id/btnTomarFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📷 Tomar foto"
                android:layout_marginBottom="12dp" />

            <!--
                Tarjeta visual para la vista previa de la fotografía.
                Mejora el aspecto general y mantiene coherencia con la pantalla
                de detalle de incidencia.
            -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E5E5E5">

                <!--
                    Vista previa de la fotografía capturada.

                    Corrección aplicada:
                    - Altura fija de 220dp para evitar que la imagen crezca demasiado
                      en tablets o pantallas grandes.
                    - fitCenter para mostrar la imagen completa sin recortarla.
                    - Fondo blanco para que visualmente quede mejor integrada.
                    - Se mantiene oculta hasta que el usuario capture una imagen.
                -->
                <ImageView
                    android:id="@+id/imgPreview"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#FFFFFF"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Botón para guardar la incidencia -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar incidencia"
                android:padding="12dp" />

            <!--
                Indicador de carga mostrado durante la subida de la imagen
                y el guardado en Supabase.
            -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</ScrollView>