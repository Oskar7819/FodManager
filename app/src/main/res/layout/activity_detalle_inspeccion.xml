<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de DetalleInspeccionActivity.
    ScrollView con tarjeta Material que agrupa toda la información
    de la inspección y el botón condicional de nueva incidencia.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#DADADA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Zona inspeccionada como título principal (ej: "ENG#1") -->
            <TextView
                android:id="@+id/tvDetalleZona"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- Fecha y hora de la inspección en gris secundario -->
            <TextView
                android:id="@+id/tvDetalleFecha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginBottom="4dp" />

            <!-- Turno operativo de la inspección.
     Lo calcula Supabase automáticamente:
     Mañana, Tarde, Noche o Cuarto turno. -->
            <TextView
                android:id="@+id/tvDetalleTurnoInspeccion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Turno: No registrado"
                android:textSize="14sp"
                android:textColor="@android:color/darker_gray"
                android:layout_marginBottom="16dp" />

            <!-- Resultado de la inspección: "⚠️ Con FOD" o "✅ Todo OK · Sin FOD" -->
            <TextView
                android:id="@+id/tvDetalleConFod"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:layout_marginBottom="16dp" />

            <!-- Cabecera de la sección de observaciones -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Observaciones"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <!-- Texto libre de observaciones del inspector; "Sin observaciones" si está vacío -->
            <TextView
                android:id="@+id/tvDetalleObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!-- Cabecera de la sección del inspector -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inspector"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />

            <!-- Nombre del inspector que realizó la inspección -->
            <TextView
                android:id="@+id/tvDetalleUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!-- Apellidos del inspector -->
            <TextView
                android:id="@+id/tvDetalleUsuarioApellidos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="4dp" />

            <!-- Número de empleado del inspector -->
            <TextView
                android:id="@+id/tvDetalleUsuarioNumeroEmpleado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

            <!--
                Botón para registrar una nueva incidencia FOD vinculada a esta inspección.
                Visible solo si conFod=true Y el rol del usuario logueado tiene permiso.
                DetalleInspeccionActivity gestiona su visibilidad en cargarDetalle().
            -->
            <Button
                android:id="@+id/btnNuevaIncidencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚠️ Registrar incidencia FOD"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</ScrollView>