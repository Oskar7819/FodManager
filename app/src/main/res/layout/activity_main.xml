<?xml version="1.0" encoding="utf-8"?>
<!--
    Pantalla de login (MainActivity).
    LinearLayout vertical centrado que actúa como contenedor principal.
    Fondo azul aeronáutico definido en colors.xml (@color/aeronautics_blue).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/aeronautics_blue">

    <!-- Logo de la aplicación centrado en la parte superior del formulario -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/img_main"
        android:layout_marginBottom="24dp"
        android:contentDescription="Logo" />

    <!-- Nombre de la aplicación -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOD Manager"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="24dp" />

    <!--
        Campo de email con estilo OutlinedBox de Material Design.
        inputType="textEmailAddress" activa el teclado de email en el dispositivo.
        hintTextColor y boxStrokeColor en negro para contraste sobre el fondo azul.
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo electrónico"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="16dp"
        app:hintTextColor="@android:color/black"
        app:boxStrokeColor="@android:color/black"
        app:placeholderTextColor="@android:color/black">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/black" />

    </com.google.android.material.textfield.TextInputLayout>

    <!--
        Campo de contraseña con togglede visibilidad activado (ojo).
        inputType="textPassword" oculta los caracteres mientras se escribe.
    -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contraseña"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:passwordToggleEnabled="true"
        app:hintTextColor="@android:color/black"
        app:boxStrokeColor="@android:color/black"
        app:placeholderTextColor="@android:color/black"
        android:layout_marginBottom="24dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/black" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón de login. Se deshabilita durante la autenticación para evitar envíos duplicados -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:padding="12dp" />

    <!--
        Indicador de carga circular. Visible solo durante el proceso de autenticación.
        Se muestra/oculta desde MainActivity mediante visibility = VISIBLE / GONE.
    -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>