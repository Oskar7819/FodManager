<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de la pantalla de login (MainActivity).
     LinearLayout vertical centrado con fondo azul aeronáutico.
     gravity="center" centra todos los elementos tanto horizontal como verticalmente -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/aeronautics_blue">

    <!-- Logo de la aplicación definido en res/drawable/img_main.png.
         contentDescription es obligatorio para accesibilidad -->
    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/img_main"
        android:layout_marginBottom="32dp"
        android:contentDescription="Logo" />

    <!-- Nombre de la aplicación en color blanco para contrastar con el fondo azul -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FOD Manager"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:layout_marginBottom="32dp" />

    <!-- Campo de texto para el email.
         TextInputLayout de Material Design proporciona el borde redondeado
         y la etiqueta flotante al escribir.
         style OutlinedBox define el estilo con borde visible -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Correo electrónico"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_marginBottom="16dp"
        app:hintTextColor="@android:color/black"
        app:boxStrokeColor="@android:color/black"
        app:placeholderTextColor="@android:color/black">

        <!-- Campo de texto interior donde el usuario escribe su email.
             inputType="textEmailAddress" muestra el teclado optimizado para emails -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textEmailAddress"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/black" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Campo de texto para la contraseña.
         passwordToggleEnabled="true" añade el icono de ojo para mostrar/ocultar
         la contraseña que el usuario está escribiendo -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contraseña"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        app:passwordToggleEnabled="true"
        app:hintTextColor="@android:color/black"
        app:boxStrokeColor="@android:color/black"
        app:placeholderTextColor="@android:color/black"
        android:layout_marginBottom="24dp">

        <!-- Campo de texto interior donde el usuario escribe su contraseña.
             inputType="textPassword" oculta los caracteres mientras se escribe -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:textColor="@android:color/black"
            android:textColorHint="@android:color/black" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Botón de login que dispara el proceso de autenticación contra Supabase Auth -->
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Iniciar sesión"
        android:padding="12dp" />

    <!-- Indicador de carga circular que se muestra mientras se procesa el login.
         Oculto por defecto (visibility="gone"), se muestra al pulsar Iniciar sesión
         y se oculta cuando el proceso termina (con éxito o con error) -->
    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:visibility="gone" />

</LinearLayout>