<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de una tarjeta de usuario en el RecyclerView de UsuariosFragment
    y en DetalleAeronaveActivity (lista de usuarios adscritos).
    UsuarioAdapter rellena sus TextViews en onBindViewHolder.
    El click sobre la tarjeta completa abre EditarUsuarioActivity.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nombre completo del usuario como título principal: "Nombre Apellidos" -->
        <TextView
            android:id="@+id/tvUsuarioNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Email del usuario en gris secundario; es también su credencial de login -->
        <TextView
            android:id="@+id/tvUsuarioEmail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- Rol del usuario precedido de la etiqueta "Rol: " (ej: "Rol: operario") -->
        <TextView
            android:id="@+id/tvUsuarioRol"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!--
            Número de empleado corporativo en gris secundario.
            Muestra "No especificado" si el campo es null.
            Sin marginBottom para que el campo de aeronave lo siga inmediatamente.
        -->
        <TextView
            android:id="@+id/tvUsuarioNumeroEmpleado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray" />

        <!--
            Aeronave asignada al usuario precedida del emoji ✈️.
            Muestra "Sin aeronave asignada" si aeronaveId es null
            o "Aeronave desconocida" si el ID no está en el mapa.
            Solo aplica a roles operario, mando_gp4 y quality.
        -->
        <TextView
            android:id="@+id/tvUsuarioAeronave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>