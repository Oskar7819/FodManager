<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de una tarjeta de aeronave en el RecyclerView de AeronaveFragment.
    MaterialCardView con elevación y esquinas redondeadas.
    AeronaveAdapter rellena sus TextViews en onBindViewHolder.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Modelo de la aeronave como título principal de la tarjeta -->
        <TextView
            android:id="@+id/tvAeronaveModelo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Número de serie en gris secundario -->
        <TextView
            android:id="@+id/tvAeronaveNumeroSerie"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- Ubicación física de la aeronave en el hangar, en gris secundario -->
        <TextView
            android:id="@+id/tvAeronaveUbicacion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- Estado con emoji de color: "🟢 Activa" o "🔴 Inactiva" -->
        <TextView
            android:id="@+id/tvAeronaveEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>