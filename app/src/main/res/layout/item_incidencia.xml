<?xml version="1.0" encoding="utf-8"?>
<!-- Declaración del documento XML con codificación UTF-8 -->

<!--
    MaterialCardView utilizada como tarjeta para mostrar
    la información de una incidencia FOD dentro de una lista.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <!--
        Contenedor interno que organiza todos los elementos
        de la incidencia en una columna vertical.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!--
            TextView que mostrará la aeronave asociada a la incidencia.
            Se muestra destacado porque es el dato principal.
        -->
        <TextView
            android:id="@+id/tvIncidenciaAeronave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que muestra la descripción de la incidencia detectada.
        -->
        <TextView
            android:id="@+id/tvIncidenciaDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que indica la zona específica del avión
            donde se ha detectado la incidencia.
        -->
        <TextView
            android:id="@+id/tvIncidenciaZonaAvion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que muestra el número de empleado
            de la persona que reportó la incidencia.
        -->
        <TextView
            android:id="@+id/tvIncidenciaNumeroEmpleado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que indica la fecha en la que se registró la incidencia.
        -->
        <TextView
            android:id="@+id/tvIncidenciaFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!--
            TextView que muestra el estado actual de la incidencia
            (por ejemplo: abierta, en proceso o cerrada).
        -->
        <TextView
            android:id="@+id/tvIncidenciaEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
