<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de una tarjeta de incidencia FOD en el RecyclerView de IncidenciasFragment.
    IncidenciasAdapter rellena sus TextViews en onBindViewHolder.
    El click sobre la tarjeta completa navega a DetalleIncidenciaActivity.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Aeronave asociada a la incidencia como título principal -->
        <TextView
            android:id="@+id/tvAeronave"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Estado con emoji de color: "🔴 Abierta" / "🟡 En proceso" / "🟢 Cerrada" -->
        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Fecha de detección + duración calculada (ej: "Detectada: 22/03/2026 10:30 · abierta 2 días") -->
        <TextView
            android:id="@+id/tvFecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@android:color/darker_gray"
            android:layout_marginBottom="4dp" />

        <!-- Resumen del declarante: "Nombre Apellidos · Nº empleado" -->
        <TextView
            android:id="@+id/tvDeclaranteResumen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <!-- Tipo de FOD con emoji identificativo (ej: "🔧 Herramientas") -->
        <TextView
            android:id="@+id/tvTipoFod"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Nivel de urgencia con indicador emoji de color -->
        <TextView
            android:id="@+id/tvPrioridad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <!-- Zona de la aeronave donde se encontró el FOD -->
        <TextView
            android:id="@+id/tvZona"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="4dp" />

        <!-- Descripción libre del hallazgo FOD -->
        <TextView
            android:id="@+id/tvDescripcion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>