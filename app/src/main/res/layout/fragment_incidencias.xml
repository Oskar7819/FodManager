<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout de IncidenciasFragment.
    LinearLayout simple que contiene únicamente el RecyclerView de incidencias.
    No tiene FAB porque las incidencias se crean desde DetalleInspeccionActivity,
    no directamente desde este fragment.
    clipToPadding=false + paddingTop/Bottom dan respiro visual al primer y último item.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerIncidencias"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="16dp"
        android:paddingBottom="16dp" />

</LinearLayout>