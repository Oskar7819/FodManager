<?xml version="1.0" encoding="utf-8"?>

<!--    Manifiesto principal de FOD Manager.
    Define los permisos requeridos, las activities y la configuración global de la aplicación.-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permiso de red. Necesario para que Supabase SDK pueda
        realizar peticiones al backend. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Permiso de cámara. Necesario para poder realizar fotografias.  -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Se declara que el uso de la camara no es obligatoria (required="false"),
    por si el dispositivo no tiene la funcionalidad de hacer fotos. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />


    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FodManager"
        android:name=".FodManagerApp">

        <!-- MainActivity pantalla de login. Es el punto de entrada de la aplicación (LAUNCHER).-->
        <activity
            android:name=".ui.main.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- HomeActivity — Contenedor principal con el Bottom Navigation.
            android:exported="false": solo puede ser iniciada por MainActivity. -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <!-- NuevaInspeccionActivity — Formulario de registro de inspección.
            parentActivityName define la activity a la que se regresa al pulsar
            el botón atrás.  -->
        <activity
            android:name=".ui.inspecciones.NuevaInspeccionActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!--
            DetalleInspeccionActivity — Vista detallada de una inspección existente.
            Desde aquí se puede navegar a NuevaIncidenciaActivity si hay Fod
            y el rol tiene permiso.  -->
        <activity
            android:name=".ui.inspecciones.DetalleInspeccionActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!--
            NuevaIncidenciaActivity — Formulario de registro de incidencia FOD.
            Solo accesible desde DetalleInspeccionActivity con una inspección
            que tenga Fod y para roles con permiso (operario, mando_gp4, quality).  -->
        <activity
            android:name=".ui.incidencias.NuevaIncidenciaActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- DetalleIncidenciaActivity — Vista detallada de una incidencia FOD.
            Incluye imagen, tipo, fechas, duración y botones de cambio de estado
            para los roles con permiso.  -->
        <activity
            android:name=".ui.incidencias.DetalleIncidenciaActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- NuevaAeronaveActivity — Formulario para registrar una nueva aeronave.
            Accesible desde el FAB de AeronaveFragment para roles con permiso
            (administrador, mando_gp4, focal_point_fod).  -->
        <activity
            android:name=".ui.aeronaves.NuevaAeronaveActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- NuevoUsuarioActivity — Formulario de alta de usuario.
            Accesible desde el FAB de UsuariosFragment.  -->
        <activity
            android:name=".ui.usuarios.NuevoUsuarioActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- EditarUsuarioActivity — Permite reasignar la aeronave de un usuario existente.
            Solo permite editar aeronave_id; el rol no es modificable desde la app. -->
        <activity
            android:name=".ui.usuarios.EditarUsuarioActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- DetalleAeronaveActivity — Vista detallada de una aeronave.
            Muestra los usuarios adscritos y el botón de desactivar para roles con permiso
            (administrador, focal_point_fod). -->
        <activity
            android:name=".ui.aeronaves.DetalleAeronaveActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity" />

        <!-- ResumenInspeccionesDiariasActivity — Lista de resúmenes diarios por aeronave/día.
            Accesible desde el botón "Ver inspecciones por día" del HomeFragment.  -->
        <activity android:name=".ui.inspecciones.ResumenInspeccionesDiariasActivity"
            android:exported="false"
            android:parentActivityName=".ui.home.HomeActivity"/>

        <activity android:name=".ui.incidencias.ImagenCompletaActivity" />


        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>




    </application>

    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

</manifest>